{
  "name": "mantine-next-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npx @opennextjs/cloudflare build --skipNextBuild",
    "deploy": "npm run build && wrangler deploy",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "export": "next build && next export",
    "typecheck": "tsc --noEmit",
    "lint": "next lint && npm run lint:stylelint",
    "lint:stylelint": "stylelint '**/*.css' --cache",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "npm run prettier:check && npm run lint && npm run typecheck && npm run jest",
    "db:migrate": "wrangler d1 migrations apply christmas-gifts-prod",
    "db:migrate:local": "wrangler d1 migrations apply christmas-gifts-prod --local",
    "db:seed": "tsx scripts/seed-database.ts > data/seed.sql && wrangler d1 execute christmas-gifts-prod --file=data/seed.sql",
    "db:seed:local": "tsx scripts/seed-database.ts > data/seed.sql && wrangler d1 execute christmas-gifts-prod --local --file=data/seed.sql"
  },
  "dependencies": {
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@next/bundle-analyzer": "^16.4.6",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-query": "^5.108.2",
    "date-fns": "^4.4.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@opennextjs/cloudflare": "^1.20.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.8",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "babel-loader": "^9.1.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-mantine": "3.2.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-testing-library": "^6.2.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.10.1",
    "stylelint": "^16.6.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  },
  "packageManager": "yarn@4.5.1"
}
