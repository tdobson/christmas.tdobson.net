&quot;]:[object Object];&amp;[data-order=&quot;2&quot;]:[object Object];--title-fw:var(--mantine-h2-font-weight);--title-lh:var(--mantine-h2-line-height);--title-fz:var(--mantine-h2-font-size)\" class=\"m_8a5d1357 mantine-Title-root\" data-order=\"2\">Q&amp;A</h2><div style=\"--accordion-chevron-size:auto\" class=\"m_9bdbb667 mantine-Accordion-root\" data-variant=\"default\" id=\"mantine-«R5eunnmtb»\" data-accordion=\"true\"><div class=\"m_fe19b709 m_9bd7b098 mantine-Accordion-item\"><button class=\"mantine-focus-auto m_6939a5e9 m_4ba585b8 mantine-Accordion-control m_87cf2631 mantine-UnstyledButton-root\" data-accordion-control=\"true\" data-chevron-position=\"right\" type=\"button\" aria-expanded=\"false\" aria-controls=\"mantine-«R5eunnmtb»-panel-question-0\" id=\"mantine-«R5eunnmtb»-control-question-0\"><span class=\"m_3f35ae96 mantine-Accordion-chevron\" data-position=\"right\"><svg viewBox=\"0 0 15 15\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:calc(1rem * var(--mantine-scale));height:calc(1rem * var(--mantine-scale));display:block\"><path d=\"M3.13523 6.15803C3.3241 5.95657 3.64052 5.94637 3.84197 6.13523L7.5 9.56464L11.158 6.13523C11.3595 5.94637 11.6759 5.95657 11.8648 6.15803C12.0536 6.35949 12.0434 6.67591 11.842 6.86477L7.84197 10.6148C7.64964 10.7951 7.35036 10.7951 7.15803 10.6148L3.15803 6.86477C2.95657 6.67591 2.94637 6.35949 3.13523 6.15803Z\" fill=\"currentColor\" fill-rule=\"evenodd\" clip-rule=\"evenodd\"></path></svg></span><span class=\"m_df3ffa0f mantine-Accordion-label\"><p style=\"font-weight:500\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\">What&#x27;s your address?</p></span></button><div style=\"box-sizing:border-box;opacity:0;transition:opacity 200ms ease;height:0;overflow:hidden;display:none\" class=\"m_df78851f mantine-Accordion-panel\" aria-hidden=\"true\" role=\"region\" id=\"mantine-«R5eunnmtb»-panel-question-0\" aria-labelledby=\"mantine-«R5eunnmtb»-control-question-0\" inert=\"\"><div class=\"m_4ba554d4 mantine-Accordion-content\"><div style=\"--stack-gap:calc(0.25rem * var(--mantine-scale));--stack-align:stretch;--stack-justify:flex-start\" class=\"m_6d731127 mantine-Stack-root\" spacing=\"md\"><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\">272 Strines Road, Marple, SK6 7GB</p></div></div></div></div><div class=\"m_fe19b709 m_9bd7b098 mantine-Accordion-item\"><button class=\"mantine-focus-auto m_6939a5e9 m_4ba585b8 mantine-Accordion-control m_87cf2631 mantine-UnstyledButton-root\" data-accordion-control=\"true\" data-chevron-position=\"right\" type=\"button\" aria-expanded=\"false\" aria-controls=\"mantine-«R5eunnmtb»-panel-question-1\" id=\"mantine-«R5eunnmtb»-control-question-1\"><span class=\"m_3f35ae96 mantine-Accordion-chevron\" data-position=\"right\"><svg viewBox=\"0 0 15 15\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:calc(1rem * var(--mantine-scale));height:calc(1rem * var(--mantine-scale));display:block\"><path d=\"M3.13523 6.15803C3.3241 5.95657 3.64052 5.94637 3.84197 6.13523L7.5 9.56464L11.158 6.13523C11.3595 5.94637 11.6759 5.95657 11.8648 6.15803C12.0536 6.35949 12.0434 6.67591 11.842 6.86477L7.84197 10.6148C7.64964 10.7951 7.35036 10.7951 7.15803 10.6148L3.15803 6.86477C2.95657 6.67591 2.94637 6.35949 3.13523 6.15803Z\" fill=\"currentColor\" fill-rule=\"evenodd\" clip-rule=\"evenodd\"></path></svg></span><span class=\"m_df3ffa0f mantine-Accordion-label\"><p style=\"font-weight:500\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\">What are you doing for New Year?</p></span></button><div style=\"box-sizing:border-box;opacity:0;transition:opacity 200ms ease;height:0;overflow:hidden;display:none\" class=\"m_df78851f mantine-Accordion-panel\" aria-hidden=\"true\" role=\"region\" id=\"mantine-«R5eunnmtb»-panel-question-1\" aria-labelledby=\"mantine-«R5eunnmtb»-control-question-1\" inert=\"\"><div class=\"m_4ba554d4 mantine-Accordion-content\"><div style=\"--stack-gap:calc(0.25rem * var(--mantine-scale));--stack-align:stretch;--stack-justify:flex-start\" class=\"m_6d731127 mantine-Stack-root\" spacing=\"md\"><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\">TBC</p></div></div></div></div><div class=\"m_fe19b709 m_9bd7b098 mantine-Accordion-item\"><button class=\"mantine-focus-auto m_6939a5e9 m_4ba585b8 mantine-Accordion-control m_87cf2631 mantine-UnstyledButton-root\" data-accordion-control=\"true\" data-chevron-position=\"right\" type=\"button\" aria-expanded=\"false\" aria-controls=\"mantine-«R5eunnmtb»-panel-question-2\" id=\"mantine-«R5eunnmtb»-control-question-2\"><span class=\"m_3f35ae96 mantine-Accordion-chevron\" data-position=\"right\"><svg viewBox=\"0 0 15 15\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:calc(1rem * var(--mantine-scale));height:calc(1rem * var(--mantine-scale));display:block\"><path d=\"M3.13523 6.15803C3.3241 5.95657 3.64052 5.94637 3.84197 6.13523L7.5 9.56464L11.158 6.13523C11.3595 5.94637 11.6759 5.95657 11.8648 6.15803C12.0536 6.35949 12.0434 6.67591 11.842 6.86477L7.84197 10.6148C7.64964 10.7951 7.35036 10.7951 7.15803 10.6148L3.15803 6.86477C2.95657 6.67591 2.94637 6.35949 3.13523 6.15803Z\" fill=\"currentColor\" fill-rule=\"evenodd\" clip-rule=\"evenodd\"></path></svg></span><span class=\"m_df3ffa0f mantine-Accordion-label\"><p style=\"font-weight:500\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\">What are your dietary requirements?</p></span></button><div style=\"box-sizing:border-box;opacity:0;transition:opacity 200ms ease;height:0;overflow:hidden;display:none\" class=\"m_df78851f mantine-Accordion-panel\" aria-hidden=\"true\" role=\"region\" id=\"mantine-«R5eunnmtb»-panel-question-2\" aria-labelledby=\"mantine-«R5eunnmtb»-control-question-2\" inert=\"\"><div class=\"m_4ba554d4 mantine-Accordion-content\"><div style=\"--stack-gap:calc(0.25rem * var(--mantine-scale));--stack-align:stretch;--stack-justify:flex-start\" class=\"m_6d731127 mantine-Stack-root\" spacing=\"md\"><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\"><strong>Jen<!-- -->:</strong> <!-- -->Coeliac - strictly no gluten/wheat/barley (even traces). Eats all meat and fish. Not a fan of sprouts.</p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\"><strong>Tim<!-- -->:</strong> <!-- -->Vegetarian, eats most things but not keen on meat substitutes.</p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\"><strong>James<!-- -->:</strong> <!-- -->Eats everything including gluten/wheat. Particularly loves clementines, satsumas, halloumi cheese and pasta.</p></div></div></div></div><div class=\"m_fe19b709 m_9bd7b098 mantine-Accordion-item\"><button class=\"mantine-focus-auto m_6939a5e9 m_4ba585b8 mantine-Accordion-control m_87cf2631 mantine-UnstyledButton-root\" data-accordion-control=\"true\" data-chevron-position=\"right\" type=\"button\" aria-expanded=\"false\" aria-controls=\"mantine-«R5eunnmtb»-panel-question-3\" id=\"mantine-«R5eunnmtb»-control-question-3\"><span class=\"m_3f35ae96 mantine-Accordion-chevron\" data-position=\"right\"><svg viewBox=\"0 0 15 15\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:calc(1rem * var(--mantine-scale));height:calc(1rem * var(--mantine-scale));display:block\"><path d=\"M3.13523 6.15803C3.3241 5.95657 3.64052 5.94637 3.84197 6.13523L7.5 9.56464L11.158 6.13523C11.3595 5.94637 11.6759 5.95657 11.8648 6.15803C12.0536 6.35949 12.0434 6.67591 11.842 6.86477L7.84197 10.6148C7.64964 10.7951 7.35036 10.7951 7.15803 10.6148L3.15803 6.86477C2.95657 6.67591 2.94637 6.35949 3.13523 6.15803Z\" fill=\"currentColor\" fill-rule=\"evenodd\" clip-rule=\"evenodd\"></path></svg></span><span class=\"m_df3ffa0f mantine-Accordion-label\"><p style=\"font-weight:500\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\">What are you likely to want to drink?</p></span></button><div style=\"box-sizing:border-box;opacity:0;transition:opacity 200ms ease;height:0;overflow:hidden;display:none\" class=\"m_df78851f mantine-Accordion-panel\" aria-hidden=\"true\" role=\"region\" id=\"mantine-«R5eunnmtb»-panel-question-3\" aria-labelledby=\"mantine-«R5eunnmtb»-control-question-3\" inert=\"\"><div class=\"m_4ba554d4 mantine-Accordion-content\"><div style=\"--stack-gap:calc(0.25rem * var(--mantine-scale));--stack-align:stretch;--stack-justify:flex-start\" class=\"m_6d731127 mantine-Stack-root\" spacing=\"md\"><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\"><strong>Tim<!-- -->:</strong> <!-- -->Alcohol-free beer, particularly the blue-label ones from Aldi/Lidl (Perlenbacher or similar) as he&#x27;ll likely be on driving duty. Occasionally enjoys a bottle of low-cost ginger wine.</p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\"><strong>Jen<!-- -->:</strong> <!-- -->G&amp;T, wine, port, etc.</p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\"><strong>James<!-- -->:</strong> <!-- -->Strictly water or cow&#x27;s milk only</p></div></div></div></div><div class=\"m_fe19b709 m_9bd7b098 mantine-Accordion-item\"><button class=\"mantine-focus-auto m_6939a5e9 m_4ba585b8 mantine-Accordion-control m_87cf2631 mantine-UnstyledButton-root\" data-accordion-control=\"true\" data-chevron-position=\"right\" type=\"button\" aria-expanded=\"false\" aria-controls=\"mantine-«R5eunnmtb»-panel-question-4\" id=\"mantine-«R5eunnmtb»-control-question-4\"><span class=\"m_3f35ae96 mantine-Accordion-chevron\" data-position=\"right\"><svg viewBox=\"0 0 15 15\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:calc(1rem * var(--mantine-scale));height:calc(1rem * var(--mantine-scale));display:block\"><path d=\"M3.13523 6.15803C3.3241 5.95657 3.64052 5.94637 3.84197 6.13523L7.5 9.56464L11.158 6.13523C11.3595 5.94637 11.6759 5.95657 11.8648 6.15803C12.0536 6.35949 12.0434 6.67591 11.842 6.86477L7.84197 10.6148C7.64964 10.7951 7.35036 10.7951 7.15803 10.6148L3.15803 6.86477C2.95657 6.67591 2.94637 6.35949 3.13523 6.15803Z\" fill=\"currentColor\" fill-rule=\"evenodd\" clip-rule=\"evenodd\"></path></svg></span><span class=\"m_df3ffa0f mantine-Accordion-label\"><p style=\"font-weight:500\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\">We&#x27;re coming to your house - what should we bring?</p></span></button><div style=\"box-sizing:border-box;opacity:0;transition:opacity 200ms ease;height:0;overflow:hidden;display:none\" class=\"m_df78851f mantine-Accordion-panel\" aria-hidden=\"true\" role=\"region\" id=\"mantine-«R5eunnmtb»-panel-question-4\" aria-labelledby=\"mantine-«R5eunnmtb»-control-question-4\" inert=\"\"><div class=\"m_4ba554d4 mantine-Accordion-content\"><div style=\"--stack-gap:calc(0.25rem * var(--mantine-scale));--stack-align:stretch;--stack-justify:flex-start\" class=\"m_6d731127 mantine-Stack-root\" spacing=\"md\"><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\">We&#x27;ll provide all the food and snacks - this lets us keep everything wheat-free without any stress.</p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\"></p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\">While it&#x27;s kind to offer to bring things, the most helpful contribution would be your time and energy! Things like:</p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\"></p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\">- Helping with prep and cleanup</p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\">- Washing and drying up</p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\">- Baby changing</p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\">- Entertaining James</p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\">- General baby management</p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\"></p><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\">We enjoy catering and we&#x27;ll make sure we&#x27;re well supplied with food, snacks, desserts and drinks.</p></div></div></div></div><div class=\"m_fe19b709 m_9bd7b098 mantine-Accordion-item\"><button class=\"mantine-focus-auto m_6939a5e9 m_4ba585b8 mantine-Accordion-control m_87cf2631 mantine-UnstyledButton-root\" data-accordion-control=\"true\" data-chevron-position=\"right\" type=\"button\" aria-expanded=\"false\" aria-controls=\"mantine-«R5eunnmtb»-panel-question-5\" id=\"mantine-«R5eunnmtb»-control-question-5\"><span class=\"m_3f35ae96 mantine-Accordion-chevron\" data-position=\"right\"><svg viewBox=\"0 0 15 15\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:calc(1rem * var(--mantine-scale));height:calc(1rem * var(--mantine-scale));display:block\"><path d=\"M3.13523 6.15803C3.3241 5.95657 3.64052 5.94637 3.84197 6.13523L7.5 9.56464L11.158 6.13523C11.3595 5.94637 11.6759 5.95657 11.8648 6.15803C12.0536 6.35949 12.0434 6.67591 11.842 6.86477L7.84197 10.6148C7.64964 10.7951 7.35036 10.7951 7.15803 10.6148L3.15803 6.86477C2.95657 6.67591 2.94637 6.35949 3.13523 6.15803Z\" fill=\"currentColor\" fill-rule=\"evenodd\" clip-rule=\"evenodd\"></path></svg></span><span class=\"m_df3ffa0f mantine-Accordion-label\"><p style=\"font-weight:500\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\">We&#x27;re coming over, can we bring Wine?</p></span></button><div style=\"box-sizing:border-box;opacity:0;transition:opacity 200ms ease;height:0;overflow:hidden;display:none\" class=\"m_df78851f mantine-Accordion-panel\" aria-hidden=\"true\" role=\"region\" id=\"mantine-«R5eunnmtb»-panel-question-5\" aria-labelledby=\"mantine-«R5eunnmtb»-control-question-5\" inert=\"\"><div class=\"m_4ba554d4 mantine-Accordion-content\"><div style=\"--stack-gap:calc(0.25rem * var(--mantine-scale));--stack-align:stretch;--stack-justify:flex-start\" class=\"m_6d731127 mantine-Stack-root\" spacing=\"md\"><p style=\"--text-fz:var(--mantine-font-size-sm);--text-lh:var(--mantine-line-height-sm)\" class=\"mantine-focus-auto m_b6d8b162 mantine-Text-root\" data-size=\"sm\">Jen has been described as a constipated alcoholic, and we have an extensive well stocked wine and spirits rack we&#x27;re keen to make some progress through. Tim barely drinks.</p></div></div></div></div></div></div></div></div><!--$--><!--/$--></main></div><script src=\"/_next/static/chunks/webpack-7cbe6f6446c73394.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[5568,[\\\"288\\\",\\\"static/chunks/288-ad97cb595d622df2.js\\\",\\\"476\\\",\\\"static/chunks/476-5afe6b8285c5a534.js\\\",\\\"95\\\",\\\"static/chunks/95-ca4aa681b292c115.js\\\",\\\"46\\\",\\\"static/chunks/46-a6ede8ef769a7e4a.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-d3a3c38fe1d5538a.js\\\"],\\\"ColorSchemeScript\\\"]\\n3:I[6374,[\\\"288\\\",\\\"static/chunks/288-ad97cb595d622df2.js\\\",\\\"476\\\",\\\"static/chunks/476-5afe6b8285c5a534.js\\\",\\\"95\\\",\\\"static/chunks/95-ca4aa681b292c115.js\\\",\\\"46\\\",\\\"static/chunks/46-a6ede8ef769a7e4a.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-d3a3c38fe1d5538a.js\\\"],\\\"MantineProvider\\\"]\\n4:I[5619,[\\\"288\\\",\\\"static/chunks/288-ad97cb595d622df2.js\\\",\\\"476\\\",\\\"static/chunks/476-5afe6b8285c5a534.js\\\",\\\"95\\\",\\\"static/chunks/95-ca4aa681b292c115.js\\\",\\\"46\\\",\\\"static/chunks/46-a6ede8ef769a7e4a.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-d3a3c38fe1d5538a.js\\\"],\\\"theme\\\"]\\n5:I[3574,[\\\"288\\\",\\\"static/chunks/288-ad97cb595d622df2.js\\\",\\\"476\\\",\\\"static/chunks/476-5afe6b8285c5a534.js\\\",\\\"95\\\",\\\"static/chunks/95-ca4aa681b292c115.js\\\",\\\"46\\\",\\\"static/chunks/46-a6ede8ef769a7e4a.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-d3a3c38fe1d5538a.js\\\"],\\\"Providers\\\"]\\n6:I[2103,[\\\"288\\\",\\\"static/chunks/288-ad97cb595d622df2.js\\\",\\\"476\\\",\\\"static/chunks/476-5afe6b8285c5a534.js\\\",\\\"95\\\",\\\"static/chunks/95-ca4aa681b292c115.js\\\",\\\"46\\\",\\\"static/chunks/46-a6ede8ef769a7e4a.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-d3a3c38fe1d5538a.js\\\"],\\\"Layout